{
 "tool": "Nodes & Paths",
 "version": "1.1.0",
 "usage": {
  "mount": "mod.mount(host, { ui: false, persist: false })",
  "setValue": "api.set(id, value)   // or api.setMany({id: value, ...})",
  "button": "api.action(action, argument?)   // control ids are 'act_' + action",
  "data": "api.setData('3, 8, 5, 12')   // number series -> nodes",
  "frame": "api.snapshotSvg(fontCss?)   // current animated frame as an SVG string",
  "dynamic": [
   "bg.stopN.color / bg.stopN.pos : one pair per background gradient stop (N = 1..stops)",
   "<role>.* : text blocks that have a control id. The poster example has title, subtitle, footer, tag. Users add more in the tool (Poster > Selected text > Control id), then call api.params() again."
  ]
